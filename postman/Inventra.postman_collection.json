            "body": {
              "mode": "raw",
              "raw": "{\n  \"kode_barang\": \"BRG-{{$randomInt}}\",\n  \"nama_barang\": \"Mouse Logitech\",\n  \"deskripsi\": \"Mouse wireless\",\n  \"category_id\": \"{{category_id}}\",\n  \"lokasi\": \"Lab Komputer\",\n  \"kondisi\": \"Baik\",\n  \"jumlah\": 10,\n  \"satuan\": \"Unit\",\n  \"tanggal_masuk\": \"2026-11-19\"\n}",
