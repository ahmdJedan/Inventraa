{
  "info": {
    "name": "Inventra API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "category_id",
      "value": ""
    },
    {
      "key": "barang_id",
      "value": ""
    },
    {
      "key": "transaksi_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Kategori",
      "item": [
        {
          "name": "GET semua kategori",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/categories",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "categories"
              ]
            }
          }
        },
        {
          "name": "POST kategori",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/categories",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "categories"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Kategori Uji\",\n  \"description\": \"Dibuat dari Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.data && j.data.id) pm.collectionVariables.set('category_id', j.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET kategori by id",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/categories/{{category_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "categories",
                "{{category_id}}"
              ]
            }
          }
        },
        {
          "name": "PUT kategori",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/categories/{{category_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "categories",
                "{{category_id}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Kategori Uji (Diubah)\",\n  \"description\": \"Deskripsi diubah\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
